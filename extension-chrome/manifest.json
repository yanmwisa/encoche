{
  "manifest_version": 3,
  "name": "Encoche : volume des onglets",
  "version": "0.1.0",
  "description": "Règle le volume des onglets qui jouent du son depuis l'encoche (app Encoche, sur ce Mac seulement).",
  "key": "",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
